backend/venv/
__pycache__/
*.pyc
.DS_Store

# Local secrets (Neon DATABASE_URL, etc.) — Render gets these as real
# environment variables in its dashboard, never from a committed file.
.env
.env.local

# portfolioiq/backend — auto-generated, never the source of truth
cas_data.json
enrichment_cache.json
gains_data.json

# Never let a real CAS statement dropped into frontend/public/ for local
# testing get committed — that folder is served as-is by Vercel, so
# anything here becomes a real person's financial statement, publicly
# downloadable by URL with no auth. Caught live: a real test file sat
# publicly reachable on the production site until this rule existed.
frontend/public/__test_*.pdf
frontend/public/__test_*.json
