# One shared portfolio database per installation; no app login is required.
DATABASE_URL=postgresql://localhost/portfolioiq
# Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
# Must be identical in API and worker. Changing it invalidates queued uploads.
APP_SECRET=
# Use 0.0.0.0 for hosted/shared access.
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:5173
