# Copy this file to .env for local development (.env itself is gitignored —
# never commit real credentials). In production (Render), set these as real
# environment variables in the service's dashboard instead of a .env file.

# Neon Postgres connection string. Get it from the Neon console: Dashboard
# -> your project -> Connect -> copy the "psql" / pooled connection string.
# It looks like:
#   postgresql://<user>:<password>@<host>.neon.tech/<database>?sslmode=require
# Not yet consumed by the app — this is the first step of moving off the
# JSON-file storage (cas_data.json/config.json/gains_data.json/
# enrichment_cache.json), which doesn't survive a Render restart because
# Render's local disk is ephemeral.
DATABASE_URL=

# Shared-secret API key — every request (except GET /api/health) must send
# it as an X-API-Key header, checked in main.py's _require_api_key
# middleware. Added after a real incident: with no auth at all and this
# repo public on GitHub, a real production upload's data was fully wiped
# via DELETE /api/all-data by an unauthenticated caller — nothing in the
# app's own code or UI could have done it. Must match the frontend's own
# VITE_API_KEY (frontend/.env.example) exactly. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=
