# One portfolio database per installation; never commit real credentials.
DATABASE_URL=postgresql://localhost/portfolioiq
# Password-free on your own machine. Hosted/shared deployments must use password.
ACCESS_MODE=local
# Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
# Must be identical in API and worker. Changing it invalidates sessions and queued uploads.
APP_SECRET=
# Required only for ACCESS_MODE=password (12+ characters); never a VITE_ variable.
OWNER_PASSWORD=
# Set false only for local HTTP development; production must use HTTPS and true.
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173
