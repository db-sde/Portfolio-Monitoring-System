# Copy this file to .env for local development (.env itself is gitignored —
# never commit real values). In production (Vercel), set these as real
# environment variables in the project's dashboard instead.

# Must match the backend's own API_KEY exactly (backend/.env.example) — the
# backend rejects every request without it. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
VITE_API_KEY=

# Only needed to point this frontend at a backend other than the same-origin
# default (e.g. an ngrok tunnel during local dev) — see api.js's own comment.
VITE_API_BASE_URL=
