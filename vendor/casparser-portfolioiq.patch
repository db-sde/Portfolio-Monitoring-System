+"""Page bounds and native handle lifetime without private CAS fixtures."""
+from types import SimpleNamespace
+import pytest
+from casparser.parsers import pageobj, extract, _investor, _isin
+
+
+def test_investor_extraction_requests_only_first_page(monkeypatch):
+    seen=[]
+    def atoms(*args, **kwargs):
+        seen.append(kwargs['page_numbers'])
+        return [[pageobj.Atom(10,100,700-i*20,690-i*20,text,'Arial') for i,text in enumerate([
+            'Email Id: test@example.test','Test Investor','Test Address','Mobile: 9999999999'])]]
+    monkeypatch.setattr(_investor,'extract_atoms',atoms)
+    result=_investor.extract_cams_kfin_investor('unused','')
+    assert result.name=='Test Investor'
+    assert seen==[[0]]
+
