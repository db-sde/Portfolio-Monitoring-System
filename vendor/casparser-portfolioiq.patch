+def test_iterator_closes_owned_document_on_error(monkeypatch):
+    closed=[]
+    class Document:
+        def __len__(self):return 1
+        def __getitem__(self,index):return SimpleNamespace(close=lambda:closed.append('page'))
+        def close(self):closed.append('doc')
+    monkeypatch.setattr(extract.pdfium,'PdfDocument',lambda *a,**k:Document())
+    def fail(page):raise ValueError('bad page')
+    monkeypatch.setattr(extract,'_walk_page_atoms',fail)
+    with pytest.raises(ValueError):list(extract.iter_pages('unused',''))
+    assert closed==['page','doc']
