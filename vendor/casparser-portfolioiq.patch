+def test_isin_session_reused_and_reset_after_failure(monkeypatch):
+    opens=[]
+    class Database:
+        def __enter__(self):opens.append(self);return self
+        def __exit__(self,*a):pass
+        def isin_lookup(self,*a,**k):return SimpleNamespace(isin='INFTEST',amfi_code='1',type='EQUITY')
+    monkeypatch.setattr(_isin,'MFISINDb',Database)
+    with pytest.raises(RuntimeError):
+        with _isin.isin_session():
+            _isin.isin_search('Fund','CAMS','X')
+            _isin.isin_search('Fund 2','CAMS','Y')
+            raise RuntimeError('test')
+    assert len(opens)==1
+    assert _isin._active_db.get() is None
+    _isin.isin_search('Other','CAMS','Z')
+    assert len(opens)==2
