 from typing import Dict, Iterable, Optional, Tuple
 
 from casparser_isin import ISINDb, MFISINDb
 
 
+_active_db = ContextVar("casparser_isin_db", default=None)
+
+
+@contextmanager
+def isin_session():
+    """Reuse one lookup session during a parse; concurrent parses stay isolated."""
+    if _active_db.get() is not None:
+        yield
+        return
+    with MFISINDb() as db:
+        token = _active_db.set(db)
+        try:
+            yield
+        finally:
+            _active_db.reset(token)
+
+
