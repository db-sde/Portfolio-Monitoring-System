+def test_page_iterator_does_not_extract_ahead_and_releases_handles(monkeypatch):
+    closed=[]
+    class Document:
+        def __len__(self):return 3
+        def __getitem__(self, index):return SimpleNamespace(index=index,close=lambda:closed.append(index))
+    walked=[]
+    def walk(page):walked.append(page.index);return []
+    monkeypatch.setattr(extract,'_walk_page_atoms',walk)
+    pages=extract.iter_pages('unused','',_doc=Document())
+    assert walked==[]
+    assert next(pages).number==1
+    assert walked==[0] and closed==[0]
+    assert [p.number for p in pages]==[2,3]
+    assert closed==[0,1,2]
